#version 450
/*
 * 86Box    A hypervisor and IBM PC system emulator that specializes in
 *          running old operating systems and software designed for IBM
 *          PC systems and compatibles from 1981 through fairly recent
 *          system designs based on the PCI bus.
 *
 *          This file is part of the 86Box distribution.
 *
 *          ATI Rage 128 Pro -- GPU backend, z-ladder pre-pass.
 *
 *          The interpreter's pixel loop (r3d_raster in
 *          vid_ati_rage128_3d.c) steps depth across a span as
 *          zline += dZdx, one rounded double add per pixel, and
 *          quantizes each value to the depth cell. The GPU backend must
 *          produce the same depth bit for bit. Each sum depends on the
 *          one before it, so the shading kernel cannot compute a pixel's
 *          depth on its own. This kernel computes it first: for every
 *          span of the segment it walks the chain and stores the
 *          quantized depth of each pixel, a "rung", in the ladder buffer
 *          (binding 6) starting at the span's px_base. The shading
 *          kernel (vid_ati_rage128_gpu_seg.comp) then reads its rung by
 *          pixel index.
 *
 *          gpu_disp_ladder in vid_ati_rage128_gpu.c records this as one
 *          dispatch per segment, before the shading runs, followed by a
 *          memory barrier so the runs see the ladder writes. Every span
 *          is walked, including spans of runs with depth off; the rungs
 *          are unused there.
 *
 *          The arithmetic is software binary64 from
 *          vid_ati_rage128_gpu_f64.glsl, because Apple GPUs have no
 *          64-bit float type. Its add gives the IEEE
 *          result for every class, so the serial walk below can step
 *          through zero, subnormal and infinite values and a NaN
 *          generated by an add comes out as NaN. Its multiply handles
 *          finite normal values and zero only; the quantize and fog
 *          helpers clamp NaN and infinity before it.
 *
 *          Thread layout: 32 lanes per span, 8 spans per 256-thread
 *          workgroup. Lane L stores the rungs whose index q has
 *          q % 32 == L. A lane can do this without walking the whole
 *          chain because the chain has a closed form inside one binade
 *          (the range of values that share one exponent). There, dZdx
 *          aligned to z's exponent splits into the same whole number of
 *          units in the last place and the same discarded remainder at
 *          every step, so round-to-nearest-even makes the same choice
 *          every step and z's mantissa changes by a fixed integer inc.
 *          A tie is the one case that depends on the mantissa: after the
 *          first step rounds a tie to even, the mantissa stays even, so
 *          every later tie rounds the same way. Rung q is then
 *          m_entry + (q - q_entry) * inc. A real add runs only on the
 *          first step in a binade and on the step that leaves it. Every
 *          lane repeats those few adds itself, so lanes need no shared
 *          memory. ladfuzz.c in tests/video/rage128/gpu compares the
 *          closed form against the double chain on random spans.
 *
 *          Inputs the closed form does not cover fall back to the
 *          serial walk on lane 0 from the first rung not yet written:
 *          a NaN, infinite, zero or subnormal z, an infinite or nonzero
 *          subnormal dZdx, a step that lands on zero, a subnormal or an
 *          infinity or changes z's sign, and a dZdx more than 10
 *          binades above z.
 *
 * Authors: skiretic.
 *
 *          Copyright 2026 skiretic.
 */
#extension GL_EXT_shader_16bit_storage : require

#include "vid_ati_rage128_gpu_f64.glsl"
#include "vid_ati_rage128_gpu_abi.glsl"

layout(local_size_x = 256) in;

layout(std430, binding = 4) readonly buffer S { seg_span_t spans[]; };
layout(std430, binding = 5) readonly buffer T { seg_tri_t tris[]; };
/* 32-bit rungs: 24-bit depth does not fit in 16 bits. */
layout(std430, binding = 6) writeonly buffer L { uint lad[]; };

layout(push_constant) uniform P { uint nspans; uint pad; } pc;

uvec2
u64_from_limbs(uvec2 v)
{
    return v; /* the ABI's limbs, low word first: the library's own form */
}

/* Table-fog operands, the same split r3d_raster makes: z clamped to
   [0, 1] (NaN to 0), then trunc(zc * 255.0 * 2^32), whose high 32 bits
   are the fog table entry (0..255) and low 32 bits the fraction toward
   the next entry. f64_mul rounds zc * 255.0 as the host's double
   multiply does; the scale by 2^32 is exact, so it becomes a shift of
   the mantissa read from the product's bit pattern. The product is at
   most 255.0, so its exponent e is at most 7 and the shift is always
   to the right. */
uvec2
f64_fogix(uvec2 zc)
{
    if (f64_is_nan(zc) || !f64_gt_zero(zc))
        zc = F64_ZERO;
    if (f64_gt_pos(zc, F64_ONE))
        zc = F64_ONE;
    uvec2 zi = f64_mul(zc, F64_255);

    if (u64_is0(zi & F64_MAG))
        return U64_0;
    int   e  = f64_exp(zi) - 1023; /* <= 7 */
    uvec2 m  = (zi & F64_MANT) | F64_HID;
    int   sh = 20 - e;             /* m * 2^(e-52) * 2^32 */

    return (sh >= 64) ? U64_0 : u64_shr(m, sh);
}

/* Stores one rung at ladder word "at". Without table fog the word is
   the quantized depth. With table fog a pixel takes two words: the
   quantized depth with the fog table entry in bits [31:24], free
   because depth is at most 24 bits, then the 32-bit fog fraction. The
   host advances px_base by two words per pixel for such spans
   (rage128_gpu_capture_span), and the shading kernel reads its fog
   operands from these words instead of walking the chain itself. */
void
put(uint at, uvec2 z, uvec2 zmaxd, bool fog)
{
    uint r = f64_zq(z, zmaxd);

    if (fog) {
        uvec2 fx = f64_fogix(z);

        lad[at]      = r | (fx.y << 24);
        lad[at + 1u] = fx.x;
    } else
        lad[at] = r;
}

void
main()
{
    uint si   = gl_GlobalInvocationID.x >> 5;
    uint lane = gl_GlobalInvocationID.x & 31u;

    if (si >= pc.nspans)
        return;

    int      n    = spans[si].x1 - spans[si].x0 + 1;
    uint     base = spans[si].px_base;
    uvec2    z    = u64_from_limbs(spans[si].zline);
    uint     ti   = uint(spans[si].tri);
    uvec2    dz   = u64_from_limbs(tris[ti].dZdx);
    /* The quantize range follows the cell width: a 2-byte cell holds
       16-bit depth (65535), and a 4-byte cell holds 24-bit depth
       (16777215) at either end of the cell. gpu_state_kernel refuses a
       draw whose interpreter zmax disagrees with this. */
    uvec2    zmaxd = (tris[ti].zbpp == 4u) ? F64_ZMAX24 : F64_65535;
    /* In the interpreter a NaN z quantizes to 0, and once z or dZdx is
       NaN every later sum is NaN too. A NaN input sends the span to the
       serial walk, which stores zero rungs from the first NaN on; the
       walk also re-tests each sum, so a NaN that an add generates
       (opposite infinities) zeroes every later rung the same way. */
    bool zpois  = f64_is_nan(z);
    bool dzpois = f64_is_nan(dz);
    bool fog    = tris[ti].ftab_en != 0u;
    uint st     = fog ? 2u : 1u;
    int  q      = 0;

    if (!zpois && !dzpois) {
        uint     ez  = uint(f64_exp(z));
        uint     edz = uint(f64_exp(dz));
        uint     sz  = f64_sgn(z), sdz = f64_sgn(dz);
        bool     ok  = ez != 0u && ez != 0x7ffu && edz != 0x7ffu;

        if (ok && edz == 0u) {
            if (!u64_is0(dz & F64_MANT))
                ok = false;
            else {
                /* dZdx is zero, so every rung (and fog pair) is the
                   same value. */
                uint  r  = f64_zq(z, zmaxd);
                uvec2 fx = fog ? f64_fogix(z) : U64_0;

                if (fog)
                    r |= fx.y << 24;
                for (q = int(lane); q < n; q += 32) {
                    lad[base + st * uint(q)] = r;
                    if (fog)
                        lad[base + st * uint(q) + 1u] = fx.x;
                }
                return;
            }
        }
        while (ok && q < n) {
            /* Entering a binade: rung q is the current z. The next step
               is a full add, which rounds any tie to an even mantissa
               before the fixed-increment run starts. */
            if ((uint(q) & 31u) == lane)
                put(base + st * uint(q), z, zmaxd, fog);
            q++;
            if (q >= n)
                return;
            uvec2 z1 = f64_add(z, dz);
            uint  e1 = uint(f64_exp(z1));

            if (e1 == 0u || e1 == 0x7ffu || f64_sgn(z1) != sz) {
                z  = z1;
                ok = false;
                break;
            }
            if (e1 != ez) {
                z  = z1;
                ez = e1;
                continue;
            }
            /* inc, in units of z's last mantissa bit: dZdx's mantissa
               shifted to z's exponent splits into a whole part a and
               the bits shifted out (tail); hlf is the tail value of
               exactly half a unit. The tail rounds to nearest, ties to
               even, which adds 1 to a's magnitude or not. */
            int   sh   = int(ez) - int(edz);
            uvec2 mant = (dz & F64_MANT) | F64_HID;
            uvec2 a, tail, hlf;
            uvec2 inc; /* signed */

            if (sh < 0) {
                if (-sh > 10) {
                    z  = z1;
                    ok = false;
                    break;
                }
                a    = u64_shl(mant, -sh);
                tail = U64_0;
                hlf  = U64_1;
            } else if (sh > 63) {
                a    = U64_0;
                tail = U64_0;
                hlf  = U64_1;
            } else if (sh == 0) {
                a    = mant;
                tail = U64_0;
                hlf  = U64_1;
            } else {
                a    = u64_shr(mant, sh);
                tail = mant & u64_sub(u64_shl(U64_1, sh), U64_1);
                hlf  = u64_shl(U64_1, sh - 1);
            }
            if (sz == sdz) {
                if (u64_gt(tail, hlf))
                    inc = u64_add(a, U64_1);
                else if (u64_lt(tail, hlf))
                    inc = a;
                else
                    inc = u64_add(a, ((a.x & 1u) != 0u) ? U64_1 : U64_0);
            } else {
                if (u64_is0(tail))
                    inc = i64_neg(a);
                else if (u64_gt(tail, hlf))
                    inc = u64_sub(i64_neg(a), U64_1);
                else if (u64_lt(tail, hlf))
                    inc = i64_neg(a);
                else
                    inc = u64_sub(i64_neg(a), ((a.x & 1u) != 0u) ? U64_1 : U64_0);
            }
            {
                uvec2 m  = z1 & F64_MANT;
                uvec2 hi = z1 & uvec2(0x00000000u, 0xfff00000u);
                uvec2 k; /* further steps that stay in the binade */
                uvec2 dq;
                uvec2 dr;
                int   cnt;

                if (i64_gt0(inc)) {
                    u64_divmod(u64_sub(u64_sub(u64_shl(U64_1, 52), U64_1), m), inc, dq, dr);
                    k = dq;
                } else if (i64_is_neg(inc)) {
                    u64_divmod(m, i64_neg(inc), dq, dr);
                    k = dq;
                    /* A nonzero tail can round below the binade floor
                       at its finer spacing. Exclude that endpoint so
                       the full add owns the crossing step. */
                    if (!u64_is0(tail) && !u64_is0(k) && u64_is0(dr))
                        k = u64_sub(k, U64_1);
                } else
                    k = i64_from_int(n);
                cnt = u64_lt(u64_add(k, U64_1), i64_from_int(n - q)) ? int(k.x) + 1 : n - q;
                /* this lane's rungs of the run: q + j with (q + j) % 32 == lane */
                for (int j = int((lane - uint(q)) & 31u); j < cnt; j += 32)
                    put(base + st * uint(q + j),
                        hi | u64_add(m, u64_mul(i64_from_int(j), inc)), zmaxd, fog);
                q += cnt;
                if (q >= n)
                    return;
                /* The step out of the binade is a full add from the
                   run's last rung; the loop's entry code stores its
                   result as the next rung. */
                z  = hi | u64_add(m, u64_mul(i64_from_int(cnt - 1), inc));
                z1 = f64_add(z, dz);
                e1 = uint(f64_exp(z1));
                if (e1 == 0u || e1 == 0x7ffu || f64_sgn(z1) != sz) {
                    z  = z1;
                    ok = false;
                    break;
                }
                z  = z1;
                ez = e1;
            }
        }
        /* Reached only when ok is false: lane 0 continues serially
           from rung q with value z. */
    }
    if (lane != 0u)
        return;
    for (; q < n; q++) {
        if (zpois) {
            lad[base + st * uint(q)] = 0u;
            if (fog)
                lad[base + st * uint(q) + 1u] = 0u;
        } else
            put(base + st * uint(q), z, zmaxd, fog);
        z     = f64_add(z, dz);
        zpois = zpois || dzpois || f64_is_nan(z);
    }
}
