#version 450
#extension GL_EXT_control_flow_attributes : require
/*
 * The S3 ViRGE and Trio3D's 2D engine on the GPU (KairoX86#272): 86Box's per-pixel draw of s3_virge_bitblt
 * (vid_s3_virge.c: READ, MIX, WRITE) for its BitBLTs, rectangle fills, lines and polygons, as runs of 1 to 3-byte
 * pixels (kairo_seg_run) on the drawing engines' shared batches (seg.glsl). The walk stays the CPU's; each pixel's
 * source and pattern are its stream words (86box/kairo_gpu_virge2d.h). A 3-byte pixel keeps the byte after it.
 *
 * Copyright 2026 MrJackSpade. GPL-2.0-or-later.
 */
#include "seg.glsl"

const uint V2_ROP = 0u, V2_BYTES = 1u, V2_WORDS = 4u;

/* The Windows ternary raster operation, bit (P << 2 | S << 1 | D), on every bit */
uint rop3(uint code, uint p, uint s, uint d)
{
    uint r = 0u;
    [[dont_unroll]] for (uint b = 0u; b < 32u; b++) {
        const uint idx = (((p >> b) & 1u) << 2) | (((s >> b) & 1u) << 1) | ((d >> b) & 1u);
        r |= ((code >> idx) & 1u) << b;
    }
    return r;
}

void card_pixels(uint seg, uint op, uint row, uint first, int i0, int i1)
{
    const uint o    = op * V2_WORDS;
    const uint pb   = ops[o + V2_BYTES];
    const uint code = ops[o + V2_ROP];
    const int  dir  = int(segs[seg * KG_WORDS + KG_DIR]);
    const uint d0   = segs[seg * KG_WORDS + KG_BIT] >> 3;
    [[dont_unroll]] for (int n = i0; n < i1; n++) {
        const uint w   = row + uint(n) * 2u;
        const uint a   = d0 + uint((int(first) + n * dir) * int(pb));
        uint       old = 0u;
        for (uint i = 0u; i < pb; i++)
            old |= rd8(a + i) << (8u * i);
        const uint res = rop3(code, stream[w + 1u], stream[w], old) & 0xffffffu;
        for (uint i = 0u; i < pb; i++)
            wr8(a + i, res >> (8u * i));
    }
}
