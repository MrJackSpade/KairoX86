<?xml version="1.0" encoding="utf-8"?>
<!-- Arabic (ar): the translation of values/strings.xml. Each EN comment is the English a string translates; update it with the translation. Check with shared/tools/translations.py check. -->
<resources>
    <!-- %1$s is the app's name, KairoX86; %2$s the emulator it runs, 86Box; %3$s the machine, IBM PC compatible;
         %4$s the bundled firmware, GLaBIOS; %5$s its GitHub repository. -->
    <!-- EN: %1$s uses %2$s\'s %3$s emulation and the %4$s firmware. Source and provenance: github.com/%5$s. -->
    <string name="credits">يستخدم %1$s محاكاة %3$s من %2$s والبرنامج الثابت %4$s. المصدر والأصل: github.com/%5$s.</string>
    <!-- EN: Choose a games folder to find the machines in it: each is a folder holding an 86box.cfg and its disks -->
    <string name="library_empty">اختر مجلد ألعاب للعثور على الأجهزة فيه: كل جهاز مجلد يحوي ملف 86box.cfg وأقراصه</string>
    <!-- %1$s is the machine's name, IBM PC compatible; %2$s the app's name, KairoX86. -->
    <!-- EN: Select the folder for your %1$s machines. %2$s finds every folder in it that holds an 86box.cfg, with its disks. -->
    <string name="folder_description">اختر المجلد لأجهزة %1$s. يجد %2$s فيه كل مجلد يحوي ملف 86box.cfg مع أقراصه.</string>
    <!-- EN: The game port\'s two joysticks. -->
    <string name="joystick_help">عصا التحكم الاثنتان لمنفذ الألعاب.</string>
    <!-- A joystick button: %1$d is its number. -->
    <!-- EN: Button %1$d -->
    <string name="joystick_button">الزر %1$d</string>
    <!-- What a library entry is, on its chip: a PC set up in a folder. -->
    <!-- EN: Machine -->
    <string name="media_machine">جهاز</string>
    <!-- %1$s is the machine's name. -->
    <!-- EN: %1$s has no 86box.cfg -->
    <string name="machine_config_missing">لا يوجد ملف 86box.cfg في %1$s</string>
    <!-- %1$s is the folder's path in the games folder. -->
    <!-- EN: The folder %1$s is gone -->
    <string name="machine_folder_missing">المجلد %1$s لم يعد موجودًا</string>
    <!-- EN: Another app can open a disk image, but KairoX86 runs machines: put the machine\'s folder in the games folder -->
    <string name="machine_external">يمكن لتطبيق آخر فتح صورة قرص، لكن KairoX86 يشغّل الأجهزة: ضع مجلد الجهاز في مجلد الألعاب</string>
    <!-- EN: Could not delete %1$s -->
    <string name="machine_delete_failed">تعذّر حذف %1$s</string>
    <!-- %1$s is the game's name in an eXoWin9x collection (KairoX86#219). -->
    <!-- EN: %1$s is set up for DOSBox-X in its collection, which KairoX86 can\'t run yet -->
    <string name="exo_dosbox_x">%1$s is set up for DOSBox-X in its collection, which KairoX86 can\'t run yet</string>
    <!-- EN: Another machine is still running -->
    <string name="machine_still_running">لا يزال جهاز آخر قيد التشغيل</string>
    <!-- EN: The machine\'s working folder could not be prepared -->
    <string name="machine_session_failed">تعذّر تجهيز مجلد عمل الجهاز</string>
    <!-- EN: A folder of the games folder could not be read -->
    <string name="machine_list_failed">تعذّرت قراءة مجلد داخل مجلد الألعاب</string>
    <!-- %1$s is a file's path in the machine's folder. -->
    <!-- EN: %1$s could not be opened -->
    <string name="machine_open_failed">تعذّر فتح %1$s</string>
    <!-- %1$s is a file's path in the machine's folder. -->
    <!-- EN: %1$s could not be written -->
    <string name="machine_write_failed">تعذّرت الكتابة في %1$s</string>
    <!-- %1$s is a file or folder's path in the machine's folder. -->
    <!-- EN: %1$s could not be created -->
    <string name="machine_create_failed">تعذّر إنشاء %1$s</string>
    <!-- %1$s is the name of a file in the machine's folder. -->
    <!-- EN: %1$s is not a name a machine\'s file can have -->
    <string name="machine_unsafe_name">%1$s ليس اسمًا يصلح لملف من ملفات الجهاز</string>
    <!-- EN: The machine\'s settings and CMOS could not be saved to its folder -->
    <string name="machine_write_back_failed">تعذّر حفظ إعدادات الجهاز وذاكرة CMOS في مجلده</string>
    <!-- What a disk image is, on its chip on the Disks page. -->
    <!-- EN: Disk -->
    <string name="media_disk">قرص</string>
    <!-- The removable drives of the Disks page. -->
    <!-- EN: Floppy A -->
    <string name="media_floppy_a">القرص المرن A</string>
    <!-- EN: Floppy B -->
    <string name="media_floppy_b">القرص المرن B</string>
    <!-- A ZIP, MO or other removable disk a machine needs, as "The %1$s this game needs is not in the library" names it. -->
    <!-- EN: Removable disk -->
    <string name="media_removable_disk">قرص قابل للإزالة</string>
    <!-- A tape a machine needs, as "The %1$s this game needs is not in the library" names it. -->
    <!-- EN: Tape -->
    <string name="media_tape">شريط</string>
    <!-- %1$s is the file's name. -->
    <!-- EN: %1$s is no floppy or CD image -->
    <string name="machine_not_disk">%1$s ليس صورة قرص مرن ولا قرص CD</string>
    <!-- A machine's 86box.cfg opened from another app before its games folder is chosen (KairoX86#210). -->
    <!-- EN: A machine starts from its games folder: choose the folder that holds it first. -->
    <string name="machine_external_config">يبدأ الجهاز من مجلد ألعابه: اختر المجلد الذي يحويه أولًا.</string>
    <!-- EN: A disk goes in a running machine -->
    <string name="machine_disk_no_machine">يوضع القرص في جهاز قيد التشغيل</string>
    <!-- The machine settings (86box.cfg), each with 86Box's own choices (Kairo#143). -->
    <!-- EN: Processor -->
    <string name="setting_processor">المعالج</string>
    <!-- EN: Video card -->
    <string name="setting_video">بطاقة الفيديو</string>
    <!-- EN: Sound card -->
    <string name="setting_sound">بطاقة الصوت</string>
    <!-- EN: Network card -->
    <string name="setting_network">بطاقة الشبكة</string>
    <!-- EN: Hard disk controller -->
    <string name="setting_hdc">متحكم القرص الصلب</string>
    <!-- EN: SCSI controller -->
    <string name="setting_scsi">متحكم SCSI</string>
    <!-- EN: Floppy controller -->
    <string name="setting_fdc">متحكم الأقراص المرنة</string>
    <!-- A card setting's choice: the one built into the machine's board. -->
    <!-- EN: Onboard -->
    <string name="setting_card_onboard">مدمجة</string>
    <!-- Why a machine or card cannot be picked. -->
    <!-- EN: Its firmware is not among the 86Box firmware you imported -->
    <string name="setting_firmware_missing">برنامجها الثابت ليس ضمن البرامج الثابتة لـ 86Box التي استوردتها</string>
    <!-- The Firmware page's group for 86Box's firmware (BIOS and device firmware) the player imports. -->
    <!-- EN: 86Box firmware -->
    <string name="firmware_rom_set">البرامج الثابتة لـ 86Box</string>
    <!-- EN: A firmware file of 86Box\'s -->
    <string name="firmware_rom_description">ملف برنامج ثابت من 86Box</string>
    <!-- EN: Import the folder holding 86Box\'s BIOS and device firmware. Each file is found by its content, whatever its name. -->
    <string name="firmware_rom_set_note">استورد المجلد الذي يحوي BIOS والبرامج الثابتة للأجهزة من 86Box. يُعرف كل ملف من محتواه أيًّا كان اسمه.</string>
    <!-- EN: 486 DOS PC -->
    <string name="preset_486">حاسوب 486 لنظام DOS</string>
    <!-- EN: Pentium Windows 9x PC -->
    <string name="preset_win9x">حاسوب Pentium لنظام Windows 9x</string>
    <!-- A machine setting (86box.cfg time_sync): the clock the guest reads. -->
    <!-- EN: Clock -->
    <string name="setting_clock">الساعة</string>
    <!-- EN: Local time -->
    <string name="setting_clock_local">الوقت المحلي</string>
    <!-- EN: The machine\'s own -->
    <string name="setting_clock_own">ساعة الجهاز نفسه</string>
    <!-- EN: Direct tap puts the pointer at your finger in DOS games. Elsewhere it moves the pointer there from the screen\'s top-left corner, which some programs do not follow. -->
    <string name="direct_touch_explanation">يضع النقر المباشر المؤشر تحت إصبعك في ألعاب DOS. وفي غيرها يحرّك المؤشر إلى هناك من الزاوية العلوية اليسرى للشاشة، وهو ما لا تتبعه بعض البرامج.</string>
</resources>
