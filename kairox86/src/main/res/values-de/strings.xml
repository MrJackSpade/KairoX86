<?xml version="1.0" encoding="utf-8"?>
<!-- German (de): the translation of values/strings.xml. Each EN comment is the English a string translates; update it with the translation. Check with shared/tools/translations.py check. -->
<resources>
    <!-- %1$s is the app's name, KairoX86; %2$s the emulator it runs, 86Box; %3$s the machine, IBM PC compatible;
         %4$s the bundled firmware, GLaBIOS; %5$s its GitHub repository. -->
    <!-- EN: %1$s uses %2$s\'s %3$s emulation and the %4$s firmware. Source and provenance: github.com/%5$s. -->
    <string name="credits">%1$s nutzt die %3$s-Emulation von %2$s und die Firmware %4$s. Quelltext und Herkunft: github.com/%5$s.</string>
    <!-- EN: Choose a games folder to find the machines in it: each is a folder holding an 86box.cfg and its disks -->
    <string name="library_empty">Wähle einen Spieleordner, um die Maschinen darin zu finden: Jede ist ein Ordner mit einer 86box.cfg und ihren Disketten</string>
    <!-- %1$s is the machine's name, IBM PC compatible; %2$s the app's name, KairoX86. -->
    <!-- EN: Select the folder for your %1$s machines. %2$s finds every folder in it that holds an 86box.cfg, with its disks. -->
    <string name="folder_description">Wähle den Ordner für deine %1$s-Maschinen. %2$s findet darin jeden Ordner mit einer 86box.cfg, samt seinen Disketten.</string>
    <!-- EN: The game port\'s two joysticks. -->
    <string name="joystick_help">Die zwei Joysticks des Gameports.</string>
    <!-- A joystick button: %1$d is its number. -->
    <!-- EN: Button %1$d -->
    <string name="joystick_button">Taste %1$d</string>
    <!-- What a library entry is, on its chip: a PC set up in a folder. -->
    <!-- EN: Machine -->
    <string name="media_machine">Maschine</string>
    <!-- %1$s is the machine's name. -->
    <!-- EN: %1$s has no 86box.cfg -->
    <string name="machine_config_missing">%1$s hat keine 86box.cfg</string>
    <!-- %1$s is the folder's path in the games folder. -->
    <!-- EN: The folder %1$s is gone -->
    <string name="machine_folder_missing">Der Ordner %1$s fehlt</string>
    <!-- EN: Another app can open a disk image, but KairoX86 runs machines: put the machine\'s folder in the games folder -->
    <string name="machine_external">Eine andere App kann ein Disk-Image öffnen, aber KairoX86 führt Maschinen aus: Lege den Ordner der Maschine in den Spieleordner</string>
    <!-- EN: Could not delete %1$s -->
    <string name="machine_delete_failed">%1$s konnte nicht gelöscht werden</string>
    <!-- %1$s is the game's name in an eXoWin9x collection, %2$s the Windows image it is set up for there (KairoX86#219). -->
    <!-- EN: %1$s is set up for %2$s, a Windows that KairoX86 can\'t run games on yet -->
    <string name="exo_windows_unsupported">%1$s is set up for %2$s, a Windows that KairoX86 can\'t run games on yet</string>
    <!-- %1$s is the game's name in an eXoWin9x collection (KairoX86#219). -->
    <!-- EN: %1$s reads its CD from a folder, which KairoX86 can\'t put in a drive yet -->
    <string name="exo_folder_cd">%1$s reads its CD from a folder, which KairoX86 can\'t put in a drive yet</string>
    <!-- EN: Another machine is still running -->
    <string name="machine_still_running">Eine andere Maschine läuft noch</string>
    <!-- EN: The machine\'s working folder could not be prepared -->
    <string name="machine_session_failed">Der Arbeitsordner der Maschine konnte nicht vorbereitet werden</string>
    <!-- EN: A folder of the games folder could not be read -->
    <string name="machine_list_failed">Ein Ordner des Spieleordners konnte nicht gelesen werden</string>
    <!-- %1$s is a file's path in the machine's folder. -->
    <!-- EN: %1$s could not be opened -->
    <string name="machine_open_failed">%1$s konnte nicht geöffnet werden</string>
    <!-- %1$s is a file's path in the machine's folder. -->
    <!-- EN: %1$s could not be written -->
    <string name="machine_write_failed">%1$s konnte nicht geschrieben werden</string>
    <!-- %1$s is a file or folder's path in the machine's folder. -->
    <!-- EN: %1$s could not be created -->
    <string name="machine_create_failed">%1$s konnte nicht erstellt werden</string>
    <!-- %1$s is the name of a file in the machine's folder. -->
    <!-- EN: %1$s is not a name a machine\'s file can have -->
    <string name="machine_unsafe_name">%1$s ist kein Name, den eine Datei einer Maschine haben kann</string>
    <!-- EN: The machine\'s settings and CMOS could not be saved to its folder -->
    <string name="machine_write_back_failed">Die Einstellungen und das CMOS der Maschine konnten nicht in ihrem Ordner gespeichert werden</string>
    <!-- What a disk image is, on its chip on the Disks page. -->
    <!-- EN: Disk -->
    <string name="media_disk">Datenträger</string>
    <!-- The removable drives of the Disks page. -->
    <!-- EN: Floppy A -->
    <string name="media_floppy_a">Diskette A</string>
    <!-- EN: Floppy B -->
    <string name="media_floppy_b">Diskette B</string>
    <!-- A ZIP, MO or other removable disk a machine needs, as "The %1$s this game needs is not in the library" names it. -->
    <!-- EN: Removable disk -->
    <string name="media_removable_disk">Wechseldatenträger</string>
    <!-- A tape a machine needs, as "The %1$s this game needs is not in the library" names it. -->
    <!-- EN: Tape -->
    <string name="media_tape">Band</string>
    <!-- %1$s is the file's name. -->
    <!-- EN: %1$s is no floppy or CD image -->
    <string name="machine_not_disk">%1$s ist kein Disketten- oder CD-Image</string>
    <!-- A machine's 86box.cfg opened from another app before its games folder is chosen (KairoX86#210). -->
    <!-- EN: A machine starts from its games folder: choose the folder that holds it first. -->
    <string name="machine_external_config">Eine Maschine startet aus ihrem Spieleordner: Wähle zuerst den Ordner, der sie enthält.</string>
    <!-- EN: A disk goes in a running machine -->
    <string name="machine_disk_no_machine">Eine Disk kommt in eine laufende Maschine</string>
    <!-- The machine settings (86box.cfg), each with 86Box's own choices (Kairo#143). -->
    <!-- EN: Processor -->
    <string name="setting_processor">Prozessor</string>
    <!-- EN: Video card -->
    <string name="setting_video">Grafikkarte</string>
    <!-- EN: Sound card -->
    <string name="setting_sound">Soundkarte</string>
    <!-- EN: Network card -->
    <string name="setting_network">Netzwerkkarte</string>
    <!-- EN: Hard disk controller -->
    <string name="setting_hdc">Festplatten-Controller</string>
    <!-- EN: SCSI controller -->
    <string name="setting_scsi">SCSI-Controller</string>
    <!-- EN: Floppy controller -->
    <string name="setting_fdc">Disketten-Controller</string>
    <!-- A card setting's choice: the one built into the machine's board. -->
    <!-- EN: Onboard -->
    <string name="setting_card_onboard">Auf der Hauptplatine</string>
    <!-- Why a machine or card cannot be picked. -->
    <!-- EN: Its firmware is not among the 86Box firmware you imported -->
    <string name="setting_firmware_missing">Ihre Firmware ist nicht unter der importierten 86Box-Firmware</string>
    <!-- The Firmware page's group for 86Box's firmware (BIOS and device firmware) the player imports. -->
    <!-- EN: 86Box firmware -->
    <string name="firmware_rom_set">86Box-Firmware</string>
    <!-- EN: A firmware file of 86Box\'s -->
    <string name="firmware_rom_description">Eine Firmware-Datei von 86Box</string>
    <!-- EN: Import the folder holding 86Box\'s BIOS and device firmware. Each file is found by its content, whatever its name. -->
    <string name="firmware_rom_set_note">Importiere den Ordner mit dem BIOS und der Geräte-Firmware von 86Box. Jede Datei wird an ihrem Inhalt erkannt, wie sie auch heißt.</string>
    <!-- EN: 486 DOS PC -->
    <string name="preset_486">486-DOS-PC</string>
    <!-- EN: Pentium Windows 9x PC -->
    <string name="preset_win9x">Pentium-PC für Windows 9x</string>
    <!-- A machine setting (86box.cfg time_sync): the clock the guest reads. -->
    <!-- EN: Clock -->
    <string name="setting_clock">Uhr</string>
    <!-- EN: Local time -->
    <string name="setting_clock_local">Ortszeit</string>
    <!-- EN: The machine\'s own -->
    <string name="setting_clock_own">Die eigene der Maschine</string>
    <!-- EN: Direct tap puts the pointer at your finger in DOS games. Elsewhere it moves the pointer there from the screen\'s top-left corner, which some programs do not follow. -->
    <string name="direct_touch_explanation">Direktes Tippen setzt den Zeiger in DOS-Spielen auf deinen Finger. Sonst bewegt es den Zeiger von der linken oberen Bildschirmecke dorthin, was manche Programme nicht mitmachen.</string>
</resources>
