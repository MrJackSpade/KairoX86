<?xml version="1.0" encoding="utf-8"?>
<!-- KairoX86's own words. The frontend's are in shared/frontend's values/strings*.xml. -->
<resources>
    <!-- %1$s is the app's name, KairoX86; %2$s the emulator it runs, 86Box; %3$s the machine, IBM PC compatible;
         %4$s the bundled firmware, GLaBIOS; %5$s its GitHub repository. -->
    <string name="credits">%1$s uses %2$s\'s %3$s emulation and the %4$s firmware. Source and provenance: github.com/%5$s.</string>
    <string name="library_empty">Choose a games folder to find the machines in it: each is a folder holding an 86box.cfg and its disks</string>
    <!-- %1$s is the machine's name, IBM PC compatible; %2$s the app's name, KairoX86. -->
    <string name="folder_description">Select the folder for your %1$s machines. %2$s finds every folder in it that holds an 86box.cfg, with its disks.</string>

    <string name="joystick_help">The game port\'s two joysticks.</string>
    <!-- A joystick button: %1$d is its number. -->
    <string name="joystick_button">Button %1$d</string>
    <!-- A direction of the second joystick: %1$s is the direction, such as Up. -->
    <string name="joystick_2" translatable="false">2 %1$s</string>

    <!-- What a library entry is, on its chip: a PC set up in a folder. -->
    <string name="media_machine">Machine</string>
    <!-- %1$s is the machine's name. -->
    <string name="machine_config_missing">%1$s has no 86box.cfg</string>
    <!-- %1$s is the folder's path in the games folder. -->
    <string name="machine_folder_missing">The folder %1$s is gone</string>
    <string name="machine_external">Another app can open a disk image, but KairoX86 runs machines: put the machine\'s folder in the games folder</string>
    <string name="machine_delete">KairoX86 does not delete a machine\'s folder: remove it in a file manager</string>
    <string name="machine_still_running">Another machine is still running</string>
    <string name="machine_session_failed">The machine\'s working folder could not be prepared</string>
    <string name="machine_list_failed">A folder of the games folder could not be read</string>
    <!-- %1$s is a file's path in the machine's folder. -->
    <string name="machine_open_failed">%1$s could not be opened</string>
    <!-- %1$s is a file's path in the machine's folder. -->
    <string name="machine_write_failed">%1$s could not be written</string>
    <!-- %1$s is a file or folder's path in the machine's folder. -->
    <string name="machine_create_failed">%1$s could not be created</string>
    <!-- %1$s is the name of a file in the machine's folder. -->
    <string name="machine_unsafe_name">%1$s is not a name a machine\'s file can have</string>
    <string name="machine_write_back_failed">The machine\'s settings and CMOS could not be saved to its folder</string>

    <!-- What a disk image is, on its chip on the Disks page. -->
    <string name="media_disk">Disk</string>
    <!-- The removable drives of the Disks page. -->
    <string name="media_floppy_a">Floppy A</string>
    <string name="media_floppy_b">Floppy B</string>
    <!-- A ZIP, MO or other removable disk a machine needs, as "The %1$s this game needs is not in the library" names it. -->
    <string name="media_removable_disk">Removable disk</string>
    <!-- A tape a machine needs, as "The %1$s this game needs is not in the library" names it. -->
    <string name="media_tape">Tape</string>
    <!-- %1$s is the file's name. -->
    <string name="machine_not_disk">%1$s is no floppy or CD image</string>
    <!-- A machine's 86box.cfg opened from another app before its games folder is chosen (KairoX86#210). -->
    <string name="machine_external_config">A machine starts from its games folder: choose the folder that holds it first.</string>
    <string name="machine_disk_no_machine">A disk goes in a running machine</string>
    <!-- The machine settings (86box.cfg), each with 86Box's own choices (Kairo#143). -->
    <string name="setting_processor">Processor</string>
    <string name="setting_video">Video card</string>
    <string name="setting_sound">Sound card</string>
    <string name="setting_network">Network card</string>
    <string name="setting_hdc">Hard disk controller</string>
    <string name="setting_scsi">SCSI controller</string>
    <string name="setting_fdc">Floppy controller</string>
    <!-- A card setting's choice: the one built into the machine's board. -->
    <string name="setting_card_onboard">Onboard</string>
    <!-- Why a machine or card cannot be picked. -->
    <string name="setting_firmware_missing">Its firmware is not among the 86Box firmware you imported</string>
    <!-- The Firmware page's group for 86Box's firmware (BIOS and device firmware) the player imports. -->
    <string name="firmware_rom_set">86Box firmware</string>
    <string name="firmware_rom_description">A firmware file of 86Box\'s</string>
    <string name="firmware_rom_set_note">Import the folder holding 86Box\'s BIOS and device firmware (its ROM set). Each file is found by its content, whatever its name.</string>
    <!-- The hardware presets a new machine starts from, on Manage library › New game. -->
    <string name="preset_xt" translatable="false">IBM PC XT</string>
    <string name="preset_486">486 DOS PC</string>
    <string name="preset_win9x">Pentium Windows 9x PC</string>
    <!-- A machine setting (86box.cfg time_sync): the clock the guest reads. -->
    <string name="setting_clock">Clock</string>
    <string name="setting_clock_local">Local time</string>
    <string name="setting_clock_utc" translatable="false">UTC</string>
    <string name="setting_clock_own">The machine\'s own</string>
    <string name="direct_touch_explanation">Direct tap puts the pointer at your finger in DOS games. Elsewhere it moves the pointer there from the screen\'s top-left corner, which some programs do not follow.</string>
</resources>
