    <string name="machine_external">다른 앱에서 디스크 이미지를 열 수는 있지만, KairoX86은 머신을 실행합니다. 머신 폴더를 게임 폴더에 넣으세요</string>
    <!-- EN: Could not delete %1$s -->
    <string name="machine_delete_failed">%1$s을(를) 삭제할 수 없습니다</string>
