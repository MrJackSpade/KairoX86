    <!-- EN: %1$s reads its CD from a folder, which KairoX86 can\'t put in a drive yet -->
    <string name="exo_folder_cd">%1$s은(는) 폴더에서 CD를 읽지만, KairoX86은 아직 폴더를 드라이브에 넣을 수 없습니다</string>
