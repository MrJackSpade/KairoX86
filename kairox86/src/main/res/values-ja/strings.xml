    <!-- EN: MIDI port -->
    <string name="setting_midi_port">MIDIポート</string>
    <!-- The sound bank FluidSynth plays General MIDI music with (KairoX86#306). -->
    <!-- EN: SoundFont -->
    <string name="setting_sound_font">サウンドフォント</string>
