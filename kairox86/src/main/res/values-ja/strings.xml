    <!-- EN: Import a SoundFont… -->
    <string name="sound_font_import">サウンドフォントを読み込む…</string>
    <!-- EN: A SoundFont is at most 2 GB; that file is larger -->
    <string name="sound_font_too_large">サウンドフォントは2 GBまでです。このファイルはそれより大きいです</string>
    <!-- EN: That file is not a SoundFont 2 (.sf2) -->
    <string name="sound_font_not_sf2">このファイルはSoundFont 2（.sf2）ではありません</string>
    <!-- EN: Network card -->
    <string name="setting_network">ネットワークカード</string>
    <!-- EN: Hard disk controller -->
    <string name="setting_hdc">ハードディスクコントローラ</string>
    <!-- EN: SCSI controller -->
    <string name="setting_scsi">SCSI コントローラ</string>
    <!-- EN: Floppy controller -->
    <string name="setting_fdc">フロッピーコントローラ</string>
    <!-- A card setting's choice: the one built into the machine's board. -->
    <!-- EN: Onboard -->
    <string name="setting_card_onboard">オンボード</string>
    <!-- Why a machine or card cannot be picked. -->
    <!-- EN: Its firmware is not among the 86Box firmware you imported -->
    <string name="setting_firmware_missing">そのファームウェアはインポートした 86Box ファームウェアにありません</string>
    <!-- The Firmware page's group for 86Box's firmware (BIOS and device firmware) the player imports. -->
    <!-- EN: 86Box firmware -->
    <string name="firmware_rom_set">86Box ファームウェア</string>
    <!-- EN: A firmware file of 86Box\'s -->
    <string name="firmware_rom_description">86Box のファームウェアファイル</string>
    <!-- EN: Import the folder holding 86Box\'s BIOS and device firmware. Each file is found by its content, whatever its name. -->
    <string name="firmware_rom_set_note">86Box の BIOS とデバイスのファームウェアが入ったフォルダをインポートしてください。各ファイルは名前に関係なく中身で見分けられます。</string>
    <!-- EN: 486 DOS PC -->
    <string name="preset_486">DOS 用 486 PC</string>
    <!-- EN: Pentium Windows 9x PC -->
    <string name="preset_win9x">Windows 9x 用 Pentium PC</string>
    <!-- New game (KairoX86#332): a PC with no preset's defaults, and the workflow's pages for the processor and memory and for the cards. -->
    <!-- EN: Custom PC -->
    <string name="preset_custom">カスタムPC</string>
    <!-- EN: Processor and memory -->
    <string name="new_game_processor_memory">プロセッサとメモリ</string>
    <!-- EN: Cards -->
    <string name="new_game_cards">カード</string>
    <!-- A machine setting (86box.cfg time_sync): the clock the guest reads. -->
    <!-- EN: Clock -->
    <string name="setting_clock">時計</string>
    <!-- EN: Local time -->
    <string name="setting_clock_local">現地時刻</string>
    <!-- EN: The machine\'s own -->
    <string name="setting_clock_own">マシン自身の時計</string>
    <!-- EN: Direct tap puts the pointer at your finger in DOS games. Elsewhere it moves the pointer there from the screen\'s top-left corner, which some programs do not follow. -->
    <string name="direct_touch_explanation">ダイレクトタップは DOS ゲームでポインタを指の位置に置きます。それ以外では画面の左上隅からポインタをそこへ動かしますが、従わないプログラムもあります。</string>
</resources>
