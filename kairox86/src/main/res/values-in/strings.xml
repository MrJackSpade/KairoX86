<?xml version="1.0" encoding="utf-8"?>
<!-- Indonesian (in): the translation of values/strings.xml. Each EN comment is the English a string translates; update it with the translation. Check with shared/tools/translations.py check. -->
<resources>
    <!-- %1$s is the app's name, KairoX86; %2$s the emulator it runs, 86Box; %3$s the machine, IBM PC compatible;
         %4$s the bundled firmware, GLaBIOS; %5$s its GitHub repository. -->
    <!-- EN: %1$s uses %2$s\'s %3$s emulation and the %4$s firmware. Source and provenance: github.com/%5$s. -->
    <string name="credits">%1$s memakai emulasi %3$s dari %2$s dan firmware %4$s. Sumber dan asal-usul: github.com/%5$s.</string>
    <!-- EN: Choose a games folder to find the machines in it: each is a folder holding an 86box.cfg and its disks -->
    <string name="library_empty">Pilih folder game untuk menemukan mesin di dalamnya: tiap mesin adalah folder berisi 86box.cfg dan disknya</string>
    <!-- %1$s is the machine's name, IBM PC compatible; %2$s the app's name, KairoX86. -->
    <!-- EN: Select the folder for your %1$s machines. %2$s finds every folder in it that holds an 86box.cfg, with its disks. -->
    <string name="folder_description">Pilih folder untuk mesin %1$s Anda. %2$s menemukan setiap folder di dalamnya yang berisi 86box.cfg, beserta disknya.</string>

    <!-- EN: The game port\'s two joysticks. -->
    <string name="joystick_help">Dua joystick pada port game.</string>
    <!-- A joystick button: %1$d is its number. -->
    <!-- EN: Button %1$d -->
    <string name="joystick_button">Tombol %1$d</string>

    <!-- What a library entry is, on its chip: a PC set up in a folder. -->
    <!-- EN: Machine -->
    <string name="media_machine">Mesin</string>
    <!-- %1$s is the machine's name. -->
    <!-- EN: %1$s has no 86box.cfg -->
    <string name="machine_config_missing">%1$s tidak punya 86box.cfg</string>
    <!-- %1$s is the folder's path in the games folder. -->
    <!-- EN: The folder %1$s is gone -->
    <string name="machine_folder_missing">Folder %1$s sudah tidak ada</string>
    <!-- EN: Another app can open a disk image, but KairoX86 runs machines: put the machine\'s folder in the games folder -->
    <string name="machine_external">Aplikasi lain dapat membuka image disk, tetapi KairoX86 menjalankan mesin: taruh folder mesin di folder game</string>
    <!-- EN: KairoX86 does not delete a machine\'s folder: remove it in a file manager -->
    <string name="machine_delete">KairoX86 tidak menghapus folder mesin: hapus folder itu di pengelola file</string>
    <!-- EN: Another machine is still running -->
    <string name="machine_still_running">Mesin lain masih berjalan</string>
    <!-- EN: The machine\'s working folder could not be prepared -->
    <string name="machine_session_failed">Folder kerja mesin tidak dapat disiapkan</string>
    <!-- EN: A folder of the games folder could not be read -->
    <string name="machine_list_failed">Sebuah folder di folder game tidak dapat dibaca</string>
    <!-- %1$s is a file's path in the machine's folder. -->
    <!-- EN: %1$s could not be opened -->
    <string name="machine_open_failed">%1$s tidak dapat dibuka</string>
    <!-- %1$s is a file's path in the machine's folder. -->
    <!-- EN: %1$s could not be written -->
    <string name="machine_write_failed">%1$s tidak dapat ditulis</string>
    <!-- %1$s is a file or folder's path in the machine's folder. -->
    <!-- EN: %1$s could not be created -->
    <string name="machine_create_failed">%1$s tidak dapat dibuat</string>
    <!-- %1$s is the name of a file in the machine's folder. -->
    <!-- EN: %1$s is not a name a machine\'s file can have -->
    <string name="machine_unsafe_name">%1$s bukan nama yang boleh dimiliki file mesin</string>
    <!-- EN: The machine\'s settings and CMOS could not be saved to its folder -->
    <string name="machine_write_back_failed">Pengaturan dan CMOS mesin tidak dapat disimpan ke foldernya</string>

    <!-- What a disk image is, on its chip on the Disks page. -->
    <!-- EN: Disk -->
    <string name="media_disk">Cakram</string>
    <!-- The removable drives of the Disks page. -->
    <!-- EN: Floppy A -->
    <string name="media_floppy_a">Disket A</string>
    <!-- EN: Floppy B -->
    <string name="media_floppy_b">Disket B</string>
    <!-- A ZIP, MO or other removable disk a machine needs, as "The %1$s this game needs is not in the library" names it. -->
    <!-- EN: Removable disk -->
    <string name="media_removable_disk">Disk lepas-pasang</string>
    <!-- A tape a machine needs, as "The %1$s this game needs is not in the library" names it. -->
    <!-- EN: Tape -->
    <string name="media_tape">Pita</string>
    <!-- %1$s is the file's name. -->
    <!-- EN: %1$s is no floppy or CD image -->
    <string name="machine_not_disk">%1$s bukan image disket atau CD</string>
    <!-- EN: A disk goes in a running machine -->
    <string name="machine_disk_no_machine">Disk dimasukkan ke mesin yang sedang berjalan</string>
    <!-- The machine settings (86box.cfg), each with 86Box's own choices (Kairo#143). -->
    <!-- EN: Processor -->
    <string name="setting_processor">Prosesor</string>
    <!-- EN: Video card -->
    <string name="setting_video">Kartu video</string>
    <!-- EN: Sound card -->
    <string name="setting_sound">Kartu suara</string>
    <!-- EN: Network card -->
    <string name="setting_network">Kartu jaringan</string>
    <!-- EN: Hard disk controller -->
    <string name="setting_hdc">Pengontrol hard disk</string>
    <!-- EN: SCSI controller -->
    <string name="setting_scsi">Pengontrol SCSI</string>
    <!-- EN: Floppy controller -->
    <string name="setting_fdc">Pengontrol disket</string>
    <!-- A card setting's choice: the one built into the machine's board. -->
    <!-- EN: Onboard -->
    <string name="setting_card_onboard">Bawaan</string>
    <!-- Why a machine or card cannot be picked. -->
    <!-- EN: Its firmware is not among the 86Box firmware you imported -->
    <string name="setting_firmware_missing">Firmware-nya tidak ada di antara firmware 86Box yang Anda impor</string>
    <!-- The Firmware page's group for 86Box's firmware (BIOS and device firmware) the player imports. -->
    <!-- EN: 86Box firmware -->
    <string name="firmware_rom_set">Firmware 86Box</string>
    <!-- EN: A firmware file of 86Box\'s -->
    <string name="firmware_rom_description">File firmware 86Box</string>
    <!-- EN: Import the folder holding 86Box\'s BIOS and device firmware (its ROM set). Each file is found by its content, whatever its name. -->
    <string name="firmware_rom_set_note">Impor folder yang berisi BIOS dan firmware perangkat 86Box (set ROM-nya). Tiap file dikenali dari isinya, apa pun namanya.</string>
    <!-- EN: 486 DOS PC -->
    <string name="preset_486">PC DOS 486</string>
    <!-- EN: Pentium Windows 9x PC -->
    <string name="preset_win9x">PC Pentium Windows 9x</string>
    <!-- A machine setting (86box.cfg time_sync): the clock the guest reads. -->
    <!-- EN: Clock -->
    <string name="setting_clock">Jam</string>
    <!-- EN: Local time -->
    <string name="setting_clock_local">Waktu setempat</string>
    <!-- EN: The machine\'s own -->
    <string name="setting_clock_own">Jam milik mesin</string>
    <!-- EN: Direct tap puts the pointer at your finger in DOS games. Elsewhere it moves the pointer there from the screen\'s top-left corner, which some programs do not follow. -->
    <string name="direct_touch_explanation">Ketuk langsung menaruh penunjuk di bawah jari Anda dalam game DOS. Di tempat lain, penunjuk digerakkan ke sana dari sudut kiri atas layar, yang tidak diikuti sebagian program.</string>
</resources>
