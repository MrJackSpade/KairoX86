# KairoX86's free machine (docs/source-import.md, "SeaBIOS"): SeaBIOS built for QEMU-style hardware,
# with SeaVGABIOS's Cirrus build for the machine's GD5446. Every symbol not named here takes its
# Kconfig default.
CONFIG_QEMU=y
# No Xen, no TPM: the machine has neither.
# CONFIG_XEN is not set
# CONFIG_TCGBIOS is not set
# No SMM: the machine takes CPUs back to the 486, and most of those have none.
# CONFIG_USE_SMM is not set
CONFIG_VGA_CIRRUS=y
